# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Required
DB_PASSWORD=change-me

# Public host name. Its DNS record must point at this server, with ports 80 and 443 open, so
# Traefik can get a Let's Encrypt certificate.
HUNTERS_DOMAIN=hunters.example.com
# Let's Encrypt account e-mail (expiry and problem notices)
ACME_EMAIL=admin@example.com

# Your EVE application from developers.eveonline.com.
# Its callback URL must be exactly https://${HUNTERS_DOMAIN}/auth/eve/callback
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# Server
HUNTERS_NAME=Hunters
HUNTERS_WEB_ENABLED=true
# Image version: latest, or pin a release such as 0.1.0
HUNTERS_TAG=latest

# Admission (optional)
HUNTERS_ACCESS_KEY_ENABLED=false
# EVE character id of the server admin (manages access keys and accounts)
HUNTERS_ADMIN_CHARACTER_ID=
