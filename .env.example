# Copy to .env and fill in. Never commit .env.

# Required
DB_PASSWORD=change-me

# Your EVE application from developers.eveonline.com.
# Its callback URL must be exactly ${HUNTERS_PUBLIC_URL}/auth/eve/callback
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
HUNTERS_PUBLIC_URL=https://hunters.example.com

# Server
HUNTERS_NAME=Hunters
HUNTERS_PORT=8080
HUNTERS_WEB_ENABLED=true
HUNTERS_BEHIND_PROXY=false
HUNTERS_TAG=latest

# Admission (optional)
HUNTERS_ACCESS_KEY_ENABLED=false
# EVE character id of the server admin (manages access keys and accounts)
HUNTERS_ADMIN_CHARACTER_ID=
