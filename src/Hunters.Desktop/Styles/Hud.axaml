<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:NewEdenSoft.Hunters.Desktop.Controls">

  <!--
    HUD styles. Colours come from ThemeService as DynamicResource Hud.{Name}Brush,
    generated from design/themes.json. See docs/design.md.
  -->

  <Styles.Resources>
    <FontFamily x:Key="Hud.DisplayFont">avares://NewEdenSoft.Hunters.Desktop/Assets/Fonts#Oxanium</FontFamily>
    <FontFamily x:Key="Hud.BodyFont">avares://NewEdenSoft.Hunters.Desktop/Assets/Fonts#Saira</FontFamily>
    <FontFamily x:Key="Hud.MonoFont">avares://NewEdenSoft.Hunters.Desktop/Assets/Fonts#JetBrains Mono</FontFamily>

    <!-- Icons (24 x 24) -->
    <StreamGeometry x:Key="Hud.Icon.Warning">M12 2 L23 21 L1 21 Z M11 9 L11 15 L13 15 L13 9 Z M11 17 L11 19 L13 19 L13 17 Z</StreamGeometry>
  </Styles.Resources>

  <!-- Window -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Hud.BgBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Hud.FgBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource Hud.BodyFont}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Text -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource Hud.DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="LetterSpacing" Value="1" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontFamily" Value="{StaticResource Hud.DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontFamily" Value="{StaticResource Hud.DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LetterSpacing" Value="0.4" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontFamily" Value="{StaticResource Hud.DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="LetterSpacing" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource Hud.FgMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="12.5" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource Hud.PrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Hud.FgMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{StaticResource Hud.MonoFont}" />
  </Style>

  <!-- Panels -->
  <Style Selector="c|HudPanel">
    <Setter Property="Background" Value="{DynamicResource Hud.SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.LineBrush}" />
    <Setter Property="BracketBrush" Value="{DynamicResource Hud.PrimaryBrush}" />
    <Setter Property="Padding" Value="18" />
  </Style>

  <!-- Buttons: <Button Classes="hud primary" /> -->
  <Style Selector="Button.hud">
    <Setter Property="Foreground" Value="{DynamicResource Hud.PrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource Hud.PrimarySoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.LineStrongBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource Hud.DisplayFont}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="18,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <c:ChamferBorder Name="PART_Border"
                         Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="1"
                         Cut="8">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </c:ChamferBorder>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.hud:pointerover">
    <Setter Property="Background" Value="{DynamicResource Hud.LineBrush}" />
  </Style>
  <Style Selector="Button.hud:focus-visible /template/ c|ChamferBorder#PART_Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.FgBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.hud.primary">
    <Setter Property="Background" Value="{DynamicResource Hud.PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Hud.OnPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.PrimaryBrush}" />
  </Style>
  <Style Selector="Button.hud.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource Hud.FgBrush}" />
  </Style>

  <Style Selector="Button.hud.danger">
    <Setter Property="Foreground" Value="{DynamicResource Hud.DangerBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.DangerBrush}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.hud.ghost">
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.hud.ghost:pointerover">
    <Setter Property="Background" Value="{DynamicResource Hud.PrimarySoftBrush}" />
  </Style>

  <!-- Small choice toggles: <Button Classes="hud toggle" Classes.primary="{Binding IsSelected}" Classes.ghost="{Binding !IsSelected}" /> -->
  <Style Selector="Button.hud.toggle">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- Text input: <TextBox Classes="hud" /> -->
  <Style Selector="TextBox.hud">
    <Setter Property="FontFamily" Value="{StaticResource Hud.MonoFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Hud.FgBrush}" />
    <Setter Property="Background" Value="{DynamicResource Hud.BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.LineStrongBrush}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="TextBox.hud:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Hud.BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.PrimaryBrush}" />
  </Style>
  <Style Selector="TextBox.hud:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Hud.BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.PrimaryBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="TextBox.hud:pointerover, TextBox.hud:focus">
    <Setter Property="Foreground" Value="{DynamicResource Hud.FgBrush}" />
  </Style>
  <Style Selector="TextBox.hud:disabled /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Hud.BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.LineBrush}" />
  </Style>

  <!-- Icons: <PathIcon Classes="warning" /> -->
  <Style Selector="PathIcon.warning">
    <Setter Property="Data" Value="{StaticResource Hud.Icon.Warning}" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Hud.WarningBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Character list rows: <Border Classes="character-row" Classes.attention="{Binding NeedsReauth}" /> -->
  <Style Selector="Border.character-row">
    <Setter Property="Padding" Value="12,10" />
    <Setter Property="Background" Value="{DynamicResource Hud.Surface2Brush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.LineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.character-row.attention">
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.WarningBrush}" />
  </Style>
  <Style Selector="Border.portrait">
    <Setter Property="Background" Value="{DynamicResource Hud.BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.LineStrongBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.character-row.attention Border.portrait">
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.WarningBrush}" />
  </Style>
  <Style Selector="Border.portrait-badge">
    <Setter Property="Background" Value="{DynamicResource Hud.BgBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.WarningBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,-5,-5" />
  </Style>

  <!-- Navigation rail: <Button Classes="nav" Classes.selected="{Binding IsSelected}" /> -->
  <Style Selector="TextBlock.nav-heading">
    <Setter Property="Margin" Value="22,8,22,6" />
    <Setter Property="FontSize" Value="10" />
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="20,8,16,8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Hud.FgMutedBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource Hud.BodyFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="2,0,0,0">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource Hud.PrimarySoftBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Hud.FgBrush}" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{DynamicResource Hud.PrimarySoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.PrimaryBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Hud.PrimaryBrush}" />
  </Style>
  <Style Selector="Button.nav:focus-visible /template/ Border#PART_Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.FgBrush}" />
  </Style>

  <!-- Status chip: <Border Classes="badge"><TextBlock Text="..." /></Border> -->
  <Style Selector="Border.badge">
    <Setter Property="Padding" Value="5,1" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.LineStrongBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.badge > TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Hud.MonoFont}" />
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="Foreground" Value="{DynamicResource Hud.PrimaryBrush}" />
  </Style>

  <!-- Overlay windows -->
  <Style Selector="TextBlock.overlay-mode">
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="LetterSpacing" Value="0.6" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Hud.FgFaintBrush}" />
  </Style>
  <Style Selector="Border.movable">
    <Setter Property="Cursor" Value="SizeAll" />
  </Style>
  <Style Selector="c|ResizeGrip">
    <Setter Property="Foreground" Value="{DynamicResource Hud.LineStrongBrush}" />
  </Style>

  <!-- Theme swatches: <Button Classes="swatch" Classes.selected="{Binding IsSelected}" /> -->
  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.LineBrush}" />
    <Setter Property="Template">
      <ControlTemplate>
        <c:ChamferBorder Name="PART_Border"
                         Background="{TemplateBinding Background}"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="1"
                         Cut="5" />
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.swatch:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-1px)" />
  </Style>
  <Style Selector="Button.swatch.selected /template/ c|ChamferBorder#PART_Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.FgBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Button.swatch:focus-visible /template/ c|ChamferBorder#PART_Border">
    <Setter Property="BorderBrush" Value="{DynamicResource Hud.FgBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

</Styles>
