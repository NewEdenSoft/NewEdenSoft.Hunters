<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NewEdenSoft.Hunters.Desktop.App"
             RequestedThemeVariant="Dark">
    <!-- Dark only: the app and its overlays sit on top of the EVE client. -->

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Styles/Hud.axaml" />
    </Application.Styles>
</Application>
