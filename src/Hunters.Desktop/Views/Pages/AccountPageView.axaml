<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:NewEdenSoft.Hunters.Desktop.ViewModels.Pages"
             xmlns:c="using:NewEdenSoft.Hunters.Desktop.Controls"
             x:Class="NewEdenSoft.Hunters.Desktop.Views.Pages.AccountPageView"
             x:DataType="p:AccountPageViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="6">
      <TextBlock Classes="label accent" Text="SYSTEM" />
      <TextBlock Classes="h1" Text="{Binding Title}" />
    </StackPanel>
    <c:HudPanel>
      <StackPanel Spacing="6">
        <TextBlock Classes="label" Text="SERVERS AND CHARACTERS" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Connect to a Hunters server, log in with EVE Online and manage your characters. Coming in Phase 1." />
      </StackPanel>
    </c:HudPanel>
  </StackPanel>
</UserControl>
