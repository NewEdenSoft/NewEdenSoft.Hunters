<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:NewEdenSoft.Hunters.Desktop.ViewModels.Pages"
             xmlns:c="using:NewEdenSoft.Hunters.Desktop.Controls"
             xmlns:m="using:NewEdenSoft.Hunters.Desktop.Map"
             xmlns:w="using:NewEdenSoft.Hunters.Desktop.Widgets"
             x:Class="NewEdenSoft.Hunters.Desktop.Views.Pages.SettingsPageView"
             x:DataType="p:SettingsPageViewModel">
  <StackPanel Spacing="20">
    <StackPanel Spacing="6">
      <TextBlock Classes="label accent" Text="SYSTEM" />
      <TextBlock Classes="h1" Text="{Binding Title}" />
    </StackPanel>

    <c:HudPanel>
      <StackPanel Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="label" Text="THEME" VerticalAlignment="Center" />
          <TextBlock Classes="h2 accent" Text="{Binding CurrentThemeName}" VerticalAlignment="Center" />
          <TextBlock Classes="label" Text="{Binding CurrentThemeGroup}" VerticalAlignment="Center" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding ThemeGroups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="p:ThemeGroupViewModel">
              <Grid ColumnDefinitions="90,*">
                <TextBlock Classes="label" Text="{Binding Name}" VerticalAlignment="Center" />
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Themes}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="8" LineSpacing="8" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="p:ThemeOptionViewModel">
                      <Button Classes="swatch"
                              Classes.selected="{Binding IsSelected}"
                              Background="{Binding Swatch}"
                              Command="{Binding SelectCommand}"
                              CommandParameter="{Binding Id}"
                              ToolTip.Tip="{Binding Name}"
                              AutomationProperties.Name="{Binding Name}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </c:HudPanel>

    <c:HudPanel>
      <StackPanel Spacing="14">
        <TextBlock Classes="label" Text="MAP" />
        <StackPanel Spacing="8">
          <StackPanel Spacing="2">
            <TextBlock Text="Layout" />
            <TextBlock Classes="muted hint" TextWrapping="Wrap"
                       Text="The 2D map is CCP's flattened layout, as in the in-game 2D map. Top-down shows the star map from above, as in space." />
          </StackPanel>
          <ItemsControl ItemsSource="{Binding MapLayoutChoices}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="m:ChoiceViewModel">
                <Button Classes="hud toggle"
                        Classes.primary="{Binding IsSelected}"
                        Classes.ghost="{Binding !IsSelected}"
                        Command="{Binding SelectCommand}"
                        Content="{Binding Label, Converter={x:Static w:UpperCaseConverter.Instance}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </c:HudPanel>

    <c:HudPanel>
      <StackPanel Spacing="14">
        <StackPanel Spacing="2">
          <TextBlock Classes="label" Text="MAP BEHAVIOUR" />
          <TextBlock Classes="muted hint" TextWrapping="Wrap"
                     Text="A click selects a system. The focus is your staging point, the origin for nearby intel and jump range. Set it by double clicking a system (when on below), from a system's menu (right click) or the selection's Focus button, or let it follow you as you move. Moves count for the character you follow, or your main while you follow nobody." />
        </StackPanel>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Double click to focus" />
            <TextBlock Classes="muted hint" TextWrapping="Wrap"
                       Text="Double clicking a system makes it the focus." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding DoubleClickFocus}" />
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Focus on entering known space" />
            <TextBlock Classes="muted hint" TextWrapping="Wrap"
                       Text="Coming out of wormhole space (or anywhere not on the map) focuses the system you arrive in." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding EnterKnownSpaceFocus}" />
        </Grid>
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="Focus after a long move" />
              <TextBlock Classes="muted hint" TextWrapping="Wrap"
                         Text="A move of at least this many gate jumps at once (a filament, a jump bridge, a cyno) focuses where you land." />
            </StackPanel>
            <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding LongMoveFocus}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding LongMoveFocus}">
            <TextBlock Classes="muted" Text="At least" VerticalAlignment="Center" />
            <ItemsControl ItemsSource="{Binding MinJumpChoices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:ChoiceViewModel">
                  <Button Classes="hud toggle"
                          Classes.primary="{Binding IsSelected}"
                          Classes.ghost="{Binding !IsSelected}"
                          Command="{Binding SelectCommand}"
                          Content="{Binding Label, Converter={x:Static w:UpperCaseConverter.Instance}}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </c:HudPanel>

    <c:HudPanel>
      <StackPanel Spacing="14">
        <TextBlock Classes="label" Text="STARTUP" />
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Text="Start in the system tray" />
            <TextBlock Classes="muted hint" TextWrapping="Wrap"
                       Text="Open only your overlays at startup. Open this window from the tray icon." />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding StartInTray}" />
        </Grid>
      </StackPanel>
    </c:HudPanel>
  </StackPanel>
</UserControl>
