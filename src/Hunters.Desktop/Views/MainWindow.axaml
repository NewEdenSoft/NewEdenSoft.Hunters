<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NewEdenSoft.Hunters.Desktop.ViewModels"
        xmlns:p="using:NewEdenSoft.Hunters.Desktop.ViewModels.Pages"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="NewEdenSoft.Hunters.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="720" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Title="Hunters">

  <Window.Resources>
    <DataTemplate x:Key="NavItem" x:DataType="p:PageViewModel">
      <Button Classes="nav"
              Classes.selected="{Binding IsSelected}"
              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
              CommandParameter="{Binding}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <Border Grid.Column="1" Classes="badge"
                  IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Badge}" />
          </Border>
        </Grid>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <DockPanel>

    <!-- Navigation rail -->
    <Border DockPanel.Dock="Left" Width="230"
            Background="{DynamicResource Hud.SurfaceBrush}"
            BorderBrush="{DynamicResource Hud.LineBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="22,24,22,28" Spacing="2">
          <TextBlock Classes="h2 accent" Text="HUNTERS" LetterSpacing="3" />
          <TextBlock Classes="label" Text="NEWEDENSOFT" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,16" Spacing="2">
          <TextBlock Classes="label nav-heading" Text="SYSTEM" />
          <ItemsControl ItemsSource="{Binding SystemPages}" ItemTemplate="{StaticResource NavItem}" />
        </StackPanel>

        <StackPanel Spacing="2">
          <TextBlock Classes="label nav-heading" Text="VIEWS" />
          <ItemsControl ItemsSource="{Binding ViewPages}" ItemTemplate="{StaticResource NavItem}" Margin="0,0,0,14" />
          <TextBlock Classes="label nav-heading" Text="WIDGETS" />
          <ItemsControl ItemsSource="{Binding WidgetPages}" ItemTemplate="{StaticResource NavItem}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Current page: padded and scrolling, or filling the area (the map) -->
    <Panel>
      <ScrollViewer IsVisible="{Binding !IsFullBleed}">
        <ContentControl Margin="36,32" MaxWidth="1040" Content="{Binding ScrollingPage}" />
      </ScrollViewer>
      <ContentControl IsVisible="{Binding IsFullBleed}" Content="{Binding FullBleedPage}" />
    </Panel>

  </DockPanel>
</Window>
