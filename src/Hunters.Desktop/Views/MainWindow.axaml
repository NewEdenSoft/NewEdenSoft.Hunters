<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NewEdenSoft.Hunters.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="NewEdenSoft.Hunters.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="720" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Title="Hunters">

  <!-- Signed out: only the login screen. Signed in: the shell with its navigation rail. -->
  <Panel>
    <ContentControl Content="{Binding Login}" IsVisible="{Binding !IsSignedIn}" />
    <ContentControl Content="{Binding Shell}" IsVisible="{Binding IsSignedIn}" />
  </Panel>
</Window>
