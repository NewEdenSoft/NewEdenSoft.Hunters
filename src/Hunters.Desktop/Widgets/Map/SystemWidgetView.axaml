<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mw="using:NewEdenSoft.Hunters.Desktop.Widgets.Map"
             xmlns:w="using:NewEdenSoft.Hunters.Desktop.Widgets"
             xmlns:m="using:NewEdenSoft.Hunters.Desktop.Map"
             xmlns:c="using:NewEdenSoft.Hunters.Desktop.Controls"
             x:Class="NewEdenSoft.Hunters.Desktop.Widgets.Map.SystemWidgetView"
             x:DataType="mw:SystemWidgetViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.ok">
      <Setter Property="Foreground" Value="{DynamicResource Hud.OkBrush}" />
    </Style>
    <Style Selector="TextBlock.danger">
      <Setter Property="Foreground" Value="{DynamicResource Hud.DangerBrush}" />
    </Style>
    <!-- Last hour: figures right-aligned in columns, headed faintly -->
    <Style Selector="Grid.metrics TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="Grid.metrics TextBlock.head">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hud.FgFaintBrush}" />
    </Style>
    <Style Selector="Grid.metrics TextBlock.figure">
      <Setter Property="FontFamily" Value="{StaticResource Hud.MonoFont}" />
    </Style>
    <Style Selector="Grid.metrics TextBlock.faint">
      <Setter Property="Foreground" Value="{DynamicResource Hud.FgFaintBrush}" />
    </Style>
    <Style Selector="Grid.metrics TextBlock.name">
      <Setter Property="Margin" Value="0" />
      <Setter Property="TextAlignment" Value="Left" />
    </Style>
    <Style Selector="Run.peak">
      <Setter Property="Foreground" Value="{DynamicResource Hud.WarningBrush}" />
    </Style>
    <Style Selector="Run.faint">
      <Setter Property="Foreground" Value="{DynamicResource Hud.FgFaintBrush}" />
    </Style>
    <!-- Hunting profiles: likely now in full colour, the rest muted -->
    <Style Selector="Run.seen">
      <Setter Property="Foreground" Value="{DynamicResource Hud.FgMutedBrush}" />
    </Style>
    <Style Selector="Run.likely">
      <Setter Property="Foreground" Value="{DynamicResource Hud.FgBrush}" />
    </Style>
    <Style Selector="Run.status-likely">
      <Setter Property="Foreground" Value="{DynamicResource Hud.WarningBrush}" />
    </Style>
    <!-- The commands, like the Nearby cards' quick controls -->
    <Style Selector="Button.quick">
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource Hud.FgBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.quick:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hud.PrimarySoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hud.PrimaryBrush}" />
    </Style>
    <Style Selector="Button.quick:disabled">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Button.quick Path">
      <Setter Property="Stroke" Value="{DynamicResource Hud.FgBrush}" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Stretch" Value="Uniform" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
  <StackPanel Spacing="10" Margin="12">
    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" IsVisible="{Binding !HasSystem}"
               Text="Select a system on the map, or focus one." />

    <StackPanel Spacing="10" IsVisible="{Binding HasSystem}">
      <!-- Why this system: the selection, the focus, or both -->
      <WrapPanel ItemSpacing="4" LineSpacing="4">
        <Border Classes="badge" IsVisible="{Binding IsSelected}"><TextBlock Text="SELECTED" /></Border>
        <Border Classes="badge" IsVisible="{Binding IsFocused}"><TextBlock Text="FOCUSED" /></Border>
      </WrapPanel>

      <!-- Name and security on one baseline across the two fonts, then the region -->
      <StackPanel Spacing="2" DataContext="{Binding System}" x:DataType="mw:MapSystemInfo">
        <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
          <Run Text="{Binding Name, FallbackValue={x:Null}}" FontFamily="{StaticResource Hud.DisplayFont}" FontSize="17" />
          <Run Text="  " />
          <Run Text="{Binding Security, FallbackValue={x:Null}}" FontFamily="{StaticResource Hud.MonoFont}" FontSize="13"
               Foreground="{Binding SecurityBrush, FallbackValue={x:Null}}" />
        </TextBlock>
        <TextBlock Classes="muted" FontSize="13" Text="{Binding Region, FallbackValue={x:Null}}" />
      </StackPanel>

      <WrapPanel ItemSpacing="4" LineSpacing="4">
        <Button Classes="hud toggle ghost" Content="ZKILLBOARD ↗" Tag="{Binding ZkillboardUrl}" Click="OnLinkClick"
                ToolTip.Tip="The system's kills on zKillboard" />
        <Button Classes="hud toggle ghost" Content="DOTLAN ↗" Tag="{Binding DotlanUrl}" Click="OnLinkClick"
                ToolTip.Tip="The system on Dotlan" />
      </WrapPanel>

      <WrapPanel ItemSpacing="4" LineSpacing="4">
        <Button Classes="hud quick" Command="{Binding ToggleFocusCommand}" ToolTip.Tip="{Binding FocusTip}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <Path Data="{StaticResource Hud.Icon.Target}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding FocusText, Converter={x:Static w:UpperCaseConverter.Instance}}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <!-- Destination as a split button: every tracked character, or ▾ for one -->
        <StackPanel Orientation="Horizontal" Spacing="1">
          <Button Classes="hud quick" Command="{Binding SetDestinationCommand}"
                  ToolTip.Tip="{Binding DestinationTip}" ToolTip.ShowOnDisabled="True">
            <Button.IsEnabled>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="HasTracked" />
                <Binding Path="Destination.IsIdle" FallbackValue="False" />
              </MultiBinding>
            </Button.IsEnabled>
            <StackPanel Orientation="Horizontal" Spacing="5">
              <Path Data="{StaticResource Hud.Icon.Flag}" VerticalAlignment="Center" />
              <!-- One TextBlock, so the word and the count share a baseline -->
              <TextBlock VerticalAlignment="Center">
                <Run Text="DESTINATION" />
                <Run Text="{Binding TrackedCountText}" FontFamily="{StaticResource Hud.MonoFont}" />
              </TextBlock>
            </StackPanel>
          </Button>
          <Button x:Name="ChooseCharacter" Classes="hud quick" Content="▾" Click="OnChooseCharacter"
                  IsEnabled="{Binding Destination.IsIdle, FallbackValue=False}"
                  ToolTip.Tip="Set the destination for one character" AutomationProperties.Name="Set the destination for one character" />
        </StackPanel>
      </WrapPanel>

      <TextBlock FontSize="12" TextWrapping="Wrap" Classes="muted"
                 Text="{Binding Destination.StatusText, FallbackValue={x:Null}}"
                 IsVisible="{Binding Destination.HasStatus, FallbackValue=False}"
                 Classes.ok="{Binding Destination.IsOk, FallbackValue=False}"
                 Classes.danger="{Binding Destination.IsDanger, FallbackValue=False}" />

      <!-- Last hour: each metric's hour, change, 24 hours and usual, the columns shared across the rows -->
      <StackPanel Spacing="4" Grid.IsSharedSizeScope="True" IsVisible="{Binding HasLastHour}">
        <TextBlock Classes="label" Text="LAST HOUR" />
        <Grid Classes="metrics">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="Hour" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="Change" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="Day" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="Usual" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="1" Classes="head" Text="hour" />
          <TextBlock Grid.Column="2" Classes="head" Text="change" />
          <TextBlock Grid.Column="3" Classes="head" Text="24 h" />
          <TextBlock Grid.Column="4" Classes="head" Text="usual" />
        </Grid>
        <ItemsControl ItemsSource="{Binding LastHour}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:MetricRow">
              <Grid Classes="metrics" Margin="0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Hour" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Change" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Day" />
                  <ColumnDefinition Width="Auto" SharedSizeGroup="Usual" />
                </Grid.ColumnDefinitions>
                <!-- The name and its peak on one baseline -->
                <TextBlock Classes="name muted" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Label}" />
                  <Run Text="{Binding PeakText}" FontSize="12" Classes.peak="{Binding IsPeakNow}" Classes.faint="{Binding !IsPeakNow}" />
                </TextBlock>
                <TextBlock Grid.Column="1" Classes="figure" FontWeight="SemiBold" Text="{Binding LastHour}" />
                <TextBlock Grid.Column="2" Classes="figure" Text="{Binding ChangeText}" ToolTip.Tip="{Binding ChangeTip}"
                           Classes.ok="{Binding IsRising}" Classes.danger="{Binding IsFalling}" Classes.faint="{Binding IsFlat}" />
                <TextBlock Grid.Column="3" Classes="figure muted" Text="{Binding Day}" />
                <TextBlock Grid.Column="4" Classes="figure faint" Text="{Binding UsualText}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Hunting profiles seen here, likely now first: badge, name and status, then pilots and last seen -->
      <StackPanel Spacing="4" IsVisible="{Binding ShowsHunting}">
        <TextBlock Classes="label" Text="HUNTING PROFILES" />
        <TextBlock FontSize="13" TextWrapping="Wrap" Classes="muted" Classes.danger="{Binding IsProfilesError}"
                   Text="{Binding ProfilesText}" IsVisible="{Binding !HasProfiles}" />
        <ItemsControl ItemsSource="{Binding Profiles}" IsVisible="{Binding HasProfiles}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="mw:SystemProfileRow">
              <Grid ColumnDefinitions="22,*,Auto" Margin="0,1">
                <c:ProfileMark Profile="{Binding Style}" FontSize="11" HorizontalAlignment="Left" VerticalAlignment="Center" />
                <!-- The name and its status on one baseline -->
                <TextBlock Grid.Column="1" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding StatusTip}">
                  <Run Text="{Binding Name}" Classes.likely="{Binding IsLikely}" Classes.seen="{Binding !IsLikely}" />
                  <Run Text="  " />
                  <Run Text="{Binding Status}" Classes.status-likely="{Binding IsLikely}" Classes.faint="{Binding !IsLikely}" />
                </TextBlock>
                <TextBlock Grid.Column="2" Classes="mono" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Hud.FgFaintBrush}" Text="{Binding Seen}" ToolTip.Tip="{Binding SeenTip}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </StackPanel>
  </ScrollViewer>
</UserControl>
