<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mw="using:NewEdenSoft.Hunters.Desktop.Widgets.Map"
             xmlns:m="using:NewEdenSoft.Hunters.Desktop.Map"
             xmlns:c="using:NewEdenSoft.Hunters.Desktop.Controls"
             xmlns:w="using:NewEdenSoft.Hunters.Desktop.Widgets"
             xmlns:hm="using:NewEdenSoft.Hunters.Desktop.Map"
             x:Class="NewEdenSoft.Hunters.Desktop.Widgets.Map.MapWidgetView"
             x:DataType="mw:MapWidgetViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.rising">
      <Setter Property="Foreground" Value="{DynamicResource Hud.OkBrush}" />
    </Style>
    <Style Selector="TextBlock.falling">
      <Setter Property="Foreground" Value="{DynamicResource Hud.DangerBrush}" />
    </Style>
    <Style Selector="TextBlock.peak">
      <Setter Property="Foreground" Value="{DynamicResource Hud.WarningBrush}" />
    </Style>
    <Style Selector="TextBlock.same">
      <Setter Property="Foreground" Value="{DynamicResource Hud.FgFaintBrush}" />
    </Style>
    <Style Selector="TextBlock.jumprange">
      <Setter Property="Foreground" Value="{DynamicResource Hud.JumpRangeBrush}" />
    </Style>
    <!-- The hover panel's distance line -->
    <Style Selector="Run.figure">
      <Setter Property="FontFamily" Value="{StaticResource Hud.MonoFont}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Hud.FgBrush}" />
    </Style>
    <Style Selector="Run.faint">
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource Hud.FgFaintBrush}" />
    </Style>
    <Style Selector="Run.jumprange">
      <Setter Property="Foreground" Value="{DynamicResource Hud.JumpRangeBrush}" />
    </Style>
    <!-- Search results in the HUD's colours rather than Fluent's -->
    <Style Selector="ListBox#SearchResults ListBoxItem">
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox#SearchResults ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox#SearchResults ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hud.PrimarySoftBrush}" />
    </Style>
    <Style Selector="ListBox#SearchResults ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Hud.PrimarySoftBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Hud.PrimaryBrush}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <!-- Translucent panels over the map -->
    <ControlTheme x:Key="MapOverlay" TargetType="ContentControl">
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Border Background="{DynamicResource Hud.SurfaceBrush}" Opacity="0.92"
                    BorderBrush="{DynamicResource Hud.LineBrush}" BorderThickness="1" />
            <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </UserControl.Resources>

  <Panel>
    <m:MapControl x:Name="Map"
                  Model="{Binding Model}"
                  Layout="{Binding Layout}"
                  Filter="{Binding Filter}"
                  Markers="{Binding Markers}"
                  FocusedSystemId="{Binding FocusedSystemId}"
                  SelectedSystemId="{Binding SelectedSystemId}"
                  Hunting="{Binding Hunting}"
                  JumpRange="{Binding JumpRange}"
                  RouteToSystemId="{Binding RouteToSystemId}"
                  RouteColor="{DynamicResource Hud.InfoColor}"
                  JumpRangeColor="{DynamicResource Hud.JumpRangeColor}"
                  HuntGlowColor="{DynamicResource Hud.HuntGlowColor}"
                  ReliableColor="{DynamicResource Hud.HuntReliableColor}"
                  HaloColor="{DynamicResource Hud.BgColor}"
                  GateColor="{DynamicResource Hud.LineStrongColor}"
                  TextColor="{DynamicResource Hud.FgColor}"
                  MutedTextColor="{DynamicResource Hud.FgMutedColor}"
                  HoverColor="{DynamicResource Hud.PrimaryColor}" />

    <!-- Hover panel, placed next to the hovered system by the code-behind -->
    <Canvas IsHitTestVisible="False">
      <ContentControl x:Name="HoverPanel" Theme="{StaticResource MapOverlay}" Padding="12,8"
                      IsVisible="{Binding HoveredSystem, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Spacing="2" DataContext="{Binding HoveredSystem}" x:DataType="mw:MapSystemInfo">
          <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Hud.DisplayFont}" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="mono" FontWeight="SemiBold" FontSize="13" Text="{Binding Security}" Foreground="{Binding SecurityBrush}" />
            <TextBlock Classes="muted" FontSize="13" Text="{Binding Region}" />
          </StackPanel>
          <!-- With a focus: gate jumps and light years from it, and with the jump range on, whether a jump drive lands here.
               One TextBlock of runs, so the figures and the words share a baseline. -->
          <Panel IsVisible="{Binding Distance, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Classes="muted" FontSize="13" DataContext="{Binding Distance}" x:DataType="mw:MapDistanceInfo">
            <Run Classes="figure" Classes.faint="{Binding !HasGates}" Text="{Binding JumpsText}" />
            <Run Text=" · " />
            <Run Classes="figure" Text="{Binding Ly}" />
            <Run Text="{Binding FromText}" />
            <Run Text="{Binding StatusText}" Classes.jumprange="{Binding IsInRange}" Classes.faint="{Binding !IsInRange}" />
          </TextBlock>
          </Panel>
          <!-- NPC kills in the last hour, the change from the hour before, the usual, and the peak -->
          <Panel IsVisible="{Binding NpcKills, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="8" DataContext="{Binding NpcKills}" x:DataType="mw:MapNpcKillsInfo">
            <TextBlock Classes="muted" FontSize="13" Text="NPC kills" />
            <TextBlock Classes="mono" FontSize="13" FontWeight="SemiBold" Text="{Binding LastHour}" />
            <TextBlock Classes="mono" FontSize="13" Text="{Binding ChangeText}" ToolTip.Tip="Since the hour before"
                       Classes.rising="{Binding IsRising}" Classes.falling="{Binding IsFalling}" Classes.same="{Binding IsSame}" />
            <TextBlock FontSize="13" Foreground="{DynamicResource Hud.FgFaintBrush}" Text="{Binding Usual}"
                       IsVisible="{Binding Usual, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <TextBlock FontSize="13" Text="{Binding Peak}" Classes.muted="{Binding !IsPeakNow}" Classes.peak="{Binding IsPeakNow}"
                       IsVisible="{Binding Peak, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
          </Panel>
          <!-- The shown hunting profiles seen here, likely now first -->
          <Border BorderBrush="{DynamicResource Hud.LineBrush}" BorderThickness="0,1,0,0" Margin="0,2,0,0" Padding="0,3,0,0"
                  IsVisible="{Binding Profiles, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ItemsControl ItemsSource="{Binding Profiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="hm:PlaceProfile">
                  <Grid ColumnDefinitions="22,*,Auto,Auto" Margin="0,1">
                    <c:ProfileMark Profile="{Binding Style}" FontSize="11" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" FontSize="13" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               Classes.muted="{Binding !IsLikely}" />
                    <!-- Someone with a routine here is usually here at this hour: the map's ring -->
                    <TextBlock Grid.Column="2" FontSize="13" Margin="12,0,0,0" Text="reliable" IsVisible="{Binding IsReliable}"
                               Foreground="{DynamicResource Hud.HuntReliableBrush}" />
                    <TextBlock Grid.Column="3" FontSize="13" Margin="12,0,0,0" Text="{Binding When}"
                               Classes.peak="{Binding IsLikely}" Classes.same="{Binding !IsLikely}"
                               ToolTip.Tip="Usually seen here at this hour (UTC), or seen here but not usually now" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <TextBlock FontSize="13" Foreground="{DynamicResource Hud.PrimaryBrush}" MaxWidth="280" TextWrapping="Wrap"
                     Text="{Binding Characters}"
                     IsVisible="{Binding Characters, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </ContentControl>
    </Canvas>

    <!-- System search (showing the focused system while nothing is typed), and the selected system; hidden by the code-behind when the map is too small for them -->
    <StackPanel x:Name="SearchArea" Margin="12" Width="260" Spacing="6"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                IsVisible="{Binding IsLoaded}">
      <ContentControl Theme="{StaticResource MapOverlay}" DataContext="{Binding Search}" x:DataType="mw:SystemSearchViewModel">
        <StackPanel>
          <Panel>
            <TextBox x:Name="SearchBox" Classes="hud" Text="{Binding Query}" PlaceholderText="Search systems  /"
                     AutomationProperties.Name="Search systems" />
            <!-- The focused system over the empty box: clicks reach the box, apart from clear -->
            <Panel>
              <Panel.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                  <Binding Path="$parent[UserControl].((mw:MapWidgetViewModel)DataContext).FocusedSystem" Converter="{x:Static ObjectConverters.IsNotNull}" />
                  <Binding Path="Query" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                  <Binding ElementName="SearchBox" Path="IsFocused" Converter="{x:Static BoolConverters.Not}" />
                </MultiBinding>
              </Panel.IsVisible>
              <Border Background="{DynamicResource Hud.SurfaceBrush}" Margin="1" IsHitTestVisible="False" />
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,0,4,0"
                    DataContext="{Binding $parent[UserControl].((mw:MapWidgetViewModel)DataContext)}" x:DataType="mw:MapWidgetViewModel">
                <Ellipse Width="10" Height="10" Stroke="{DynamicResource Hud.PrimaryBrush}" StrokeThickness="2" VerticalAlignment="Center" Margin="0,0,8,0"
                         IsHitTestVisible="False" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsHitTestVisible="False"
                            DataContext="{Binding FocusedSystem}" x:DataType="mw:MapSystemInfo">
                  <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Hud.DisplayFont}" FontWeight="SemiBold" />
                  <TextBlock Classes="mono" FontSize="12" FontWeight="SemiBold" Text="{Binding Security}" Foreground="{Binding SecurityBrush}" VerticalAlignment="Center" />
                  <TextBlock Classes="muted" FontSize="12" Text="{Binding Region}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Classes="hud toggle ghost" Content="✕" Margin="8,0,0,0" VerticalAlignment="Center"
                        Command="{Binding ClearSystemCommand}"
                        ToolTip.Tip="Clear the focused system" AutomationProperties.Name="Clear focus" />
              </Grid>
            </Panel>
          </Panel>
          <ListBox x:Name="SearchResults" ItemsSource="{Binding Results}" SelectedItem="{Binding Highlighted}"
                   IsVisible="{Binding HasResults}" Background="Transparent" Padding="0,2">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="mw:MapSystemInfo">
                <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                    <TextBlock Classes="mono" FontSize="12" FontWeight="SemiBold" Text="{Binding Security}" Foreground="{Binding SecurityBrush}" VerticalAlignment="Center" />
                    <TextBlock Classes="muted" FontSize="12" Text="{Binding Region}" VerticalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </ContentControl>

      <!-- The selected system (the one last clicked or searched for), with Focus and clear -->
      <ContentControl Theme="{StaticResource MapOverlay}" Padding="10,4,4,4"
                      IsVisible="{Binding SelectedSystem, Converter={x:Static ObjectConverters.IsNotNull}}">
        <!-- Two rows, so the name and region keep clear of the buttons in the narrow search column -->
        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
          <TextBlock Classes="label" Text="SELECTED" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="hud toggle ghost" Content="FOCUS" Margin="8,0,0,0"
                  Command="{Binding FocusSelectionCommand}" IsVisible="{Binding !IsSelectionFocused}"
                  ToolTip.Tip="Make this system the focus: the staging point for nearby intel and jump range" />
          <Button Grid.Column="2" Classes="hud toggle ghost" Content="✕" Margin="4,0,0,0"
                  Command="{Binding ClearSelectionCommand}"
                  ToolTip.Tip="Clear the selection (Esc)" AutomationProperties.Name="Clear the selection" />
          <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="Auto,Auto,*" Margin="0,2,6,4"
                DataContext="{Binding SelectedSystem}" x:DataType="mw:MapSystemInfo">
            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Hud.DisplayFont}" FontWeight="SemiBold"
                       MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="mono" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                       Text="{Binding Security}" Foreground="{Binding SecurityBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Classes="muted" FontSize="12" Margin="8,0,0,0"
                       Text="{Binding Region}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </ContentControl>
    </StackPanel>

    <!-- The focused character, with follow and dismiss -->
    <ContentControl Theme="{StaticResource MapOverlay}" Padding="8,6" Margin="12"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
      <ContentControl.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsLoaded" />
          <Binding Path="HasFocus" />
        </MultiBinding>
      </ContentControl.IsVisible>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <c:MarkerBadge Marker="{Binding FocusedMarker}" Width="20" Height="20" Cut="5" VerticalAlignment="Center" />
        <TextBlock Classes="label" Foreground="{DynamicResource Hud.FgBrush}" VerticalAlignment="Center" MaxWidth="180"
                   TextTrimming="CharacterEllipsis"
                   Text="{Binding FocusedName, Converter={x:Static w:UpperCaseConverter.Instance}}" />
        <Button Classes="hud toggle" Classes.primary="{Binding IsFollowing}" Classes.ghost="{Binding !IsFollowing}"
                Command="{Binding ToggleFollowCommand}"
                ToolTip.Tip="Keep the map on this character as it moves. Dragging the map stops following.">
          <Panel>
            <TextBlock Text="FOLLOW" IsVisible="{Binding !IsFollowing}" />
            <TextBlock Text="FOLLOWING" IsVisible="{Binding IsFollowing}" />
          </Panel>
        </Button>
        <Button Classes="hud toggle ghost" Content="✕" Command="{Binding DismissFocusCommand}"
                ToolTip.Tip="Stop focusing on this character" AutomationProperties.Name="Dismiss" />
      </StackPanel>
    </ContentControl>

    <!-- What "Navigate to" in a system's menu came to, at the bottom of the map -->
    <ContentControl Theme="{StaticResource MapOverlay}" Padding="12,6" Margin="12" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    IsVisible="{Binding Destination.HasStatus, FallbackValue=False}">
      <TextBlock FontSize="13" TextWrapping="Wrap" MaxWidth="480" Text="{Binding Destination.StatusText, FallbackValue={x:Null}}"
                 Classes.muted="{Binding !Destination.HasStatus, FallbackValue=True}"
                 Classes.rising="{Binding Destination.IsOk, FallbackValue=False}"
                 Classes.falling="{Binding Destination.IsDanger, FallbackValue=False}" />
    </ContentControl>

    <!-- Not loaded: logged out, loading, being prepared, or an error -->
    <StackPanel IsVisible="{Binding IsNotLoaded}" MaxWidth="360" Margin="16" Spacing="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Classes="muted" Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding !HasError}" />
        <TextBlock Foreground="{DynamicResource Hud.DangerBrush}" Text="{Binding StatusText}" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding HasError}" />
        <Button Classes="hud" Content="TRY AGAIN" HorizontalAlignment="Center"
                Command="{Binding RetryCommand}" IsVisible="{Binding HasError}" />
    </StackPanel>
  </Panel>
</UserControl>
