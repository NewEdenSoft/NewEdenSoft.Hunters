<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mw="using:NewEdenSoft.Hunters.Desktop.Widgets.Map"
             xmlns:m="using:NewEdenSoft.Hunters.Desktop.Map"
             xmlns:w="using:NewEdenSoft.Hunters.Desktop.Widgets"
             x:Class="NewEdenSoft.Hunters.Desktop.Widgets.Map.JumpRangeWidgetView"
             x:DataType="mw:JumpRangeWidgetViewModel">
  <ScrollViewer>
  <StackPanel Spacing="12" Margin="12">
    <StackPanel Spacing="6">
      <TextBlock Classes="label" Text="SHOW" />
      <Button Classes="hud toggle" Classes.primary="{Binding IsOn}" Classes.ghost="{Binding !IsOn}" HorizontalAlignment="Left"
              Command="{Binding ToggleCommand}"
              Content="{Binding ToggleText, Converter={x:Static w:UpperCaseConverter.Instance}}" />
    </StackPanel>
    <StackPanel Spacing="6">
      <TextBlock Classes="label" Text="RANGE" />
      <ItemsControl ItemsSource="{Binding Presets}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel ItemSpacing="4" LineSpacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:ChoiceViewModel">
            <Button Classes="hud toggle"
                    Classes.primary="{Binding IsSelected}"
                    Classes.ghost="{Binding !IsSelected}"
                    Command="{Binding SelectCommand}"
                    ToolTip.Tip="{Binding ToolTip}"
                    Content="{Binding Label, Converter={x:Static w:UpperCaseConverter.Instance}}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Classes="muted" FontSize="13" Text="Custom" VerticalAlignment="Center" />
      <TextBox Classes="hud mono" Width="80" Text="{Binding CustomText}"
               ToolTip.Tip="0.5 to 20 light years" AutomationProperties.Name="Custom jump range in light years" />
      <TextBlock Classes="muted" FontSize="13" Text="ly" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Text="{Binding Hint}" />
  </StackPanel>
  </ScrollViewer>
</UserControl>
